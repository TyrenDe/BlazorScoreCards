@inherits Fluxor.Blazor.Web.Components.FluxorComponent

<MudDialog DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <div @onkeydown:stopPropagation="true"
             @onkeyup:stopPropagation="true">
            <MudTextField
                @ref="textField"
                FullWidth="true"
                Required="true"
                AutoFocus="true"
                @bind-Value="@PlayerName"
                OnKeyUp="HandleKeyUp"
                Label="Player or Team Name"/>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="AddPlayer">Ok</MudButton>
    </DialogActions>
</MudDialog>
